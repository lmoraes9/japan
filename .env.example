# Variáveis do app. Os valores de verdade ficam só no painel da Vercel
# (Settings → Environment Variables). Nada aqui é necessário para buildar:
# sem elas, o mapa cai nos links do Google Maps e o sync fica desligado.
# NÃO coloque valores reais neste arquivo: o repositório é público.

# Mapa (src/components/MapView.tsx)
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=
NEXT_PUBLIC_GOOGLE_MAPS_MAP_ID=

# Sync entre os celulares (src/app/api/sync/route.ts): um dos dois pares
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# KV_REST_API_URL=
# KV_REST_API_TOKEN=
